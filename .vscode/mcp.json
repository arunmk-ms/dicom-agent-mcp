{
    "inputs": [
        {
            "id": "azureToken",
            "type": "promptString",
            "description": "Azure DICOM access token",
            "password": true
        }
    ],
    "servers": {
        "dicom": {
            "type": "stdio",
            "command": "uvx",
            "args": [
                "dicom-agent-mcp",
                "--node", "orthanc=dimse://ORTHANC@localhost:4242",
                "--node", "orthanc-web=http://localhost:8042/dicom-web",
                "--node", "azure-dicom=https://<workspace>-<service>.dicom.azurehealthcareapis.com/v2;token-env=AZURE_DICOM_TOKEN;read-only",
                "--storage-dir", "${workspaceFolder}/dicom-cache"
            ],
            "env": {
                "AZURE_DICOM_TOKEN": "${input:azureToken}"
            }
        }
    }
}